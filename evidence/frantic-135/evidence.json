  "issues_and_changes": [
    {
      "identifier": "POST /v1/open-inbox",
      "issue": "The service requires a complete catalog-bound envelope in addition to the human-readable skill instructions.",
      "change": "Publish a generated copy-ready envelope directly beside each live offer revision."
    },
    {
      "identifier": "resource_access.capability",
      "issue": "The paid response returns a bearer capability that is necessary for lifecycle calls but must not enter logs, receipts, query strings, or public evidence.",
      "change": "Return a clearly labeled host-bound secret field plus a redacted evidence example in the official HTTP walkthrough."
    },
    {
      "identifier": "GET /v1/agent-inboxes/{inbox_id}/messages",
      "issue": "Mail delivery is asynchronous and an empty bounded page is not a failure, so callers must preserve the opaque cursor and poll again.",
      "change": "Return a suggested next-poll timestamp or explicit delivery state alongside the continuation cursor."
    },
    {
      "identifier": "DELETE /v1/agent-inboxes/{inbox_id}",
      "issue": "Cleanup is a separate lifecycle request that clients must perform even after a successful read-back.",
      "change": "Add a short finally-block example that deletes the lease without ever serializing the capability."
    }
  ]
